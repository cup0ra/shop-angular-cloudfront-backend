{
  "name": "shop-angular-cloudfront-backend",
  "version": "0.1.0",
  "bin": {
    "shop-angular-cloudfront-backend": "bin/shop-angular-cloudfront-backend.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "format": "prettier --write \"**/*.{ts,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,yml,yaml}\"",
    "swagger:ui": "node scripts/serve-swagger-ui.mjs",
    "seed": "tsc scripts/seed.ts && node scripts/seed.js",
    "cdk": "cdk",
    "cdk:synth": "cdk synth",
    "cdk:deploy": "cdk deploy --all",
    "cdk:deploy:dev": "cdk deploy ProductServiceStackDev AuthorizationServiceStackDev ImportServiceStackDev",
    "cdk:deploy:prod": "cdk deploy ProductServiceStackProd AuthorizationServiceStackProd ImportServiceStackProd",
    "cdk:destroy": "cdk destroy --all",
    "build-deploy": "npm run build && npm run cdk:deploy"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.161",
    "@types/jest": "^30",
    "@types/node": "^24.10.1",
    "aws-cdk": "2.1114.1",
    "esbuild": "^0.28.0",
    "jest": "^30",
    "prettier": "^3.8.1",
    "swagger-ui-dist": "^5.32.1",
    "ts-jest": "^29",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1026.0",
    "@aws-sdk/client-s3": "^3.1041.0",
    "@aws-sdk/client-sns": "^3.1045.0",
    "@aws-sdk/client-sqs": "^3.1045.0",
    "@aws-sdk/lib-dynamodb": "^3.1029.0",
    "@aws-sdk/s3-request-presigner": "^3.1041.0",
    "@aws-sdk/util-dynamodb": "^3",
    "@types/uuid": "^10.0.0",
    "aws-cdk-lib": "^2.244.0",
    "constructs": "^10.5.0",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.4.2",
    "uuid": "^14.0.0",
    "zod": "^3.23.8"
  }
}
